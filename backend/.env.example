# Copy to backend/.env if you want these values without setting them in the shell.
# Process environment variables override this file.
# Do not put secrets in this file. The sensor service does not use an API key.

SENSOR_SERIAL_PORT=COM6
SENSOR_BAUD_RATE=115200
SENSOR_SERIAL_ENABLED=1

# Listen on local interfaces so a phone on the same Wi-Fi can connect.
# Do not forward this port on a router.
SENSOR_API_HOST=0.0.0.0
SENSOR_API_PORT=8000

# Optional thresholds. Leave them unset until you choose the numbers.
# Empty values disable the rule. These are not official fire thresholds.
# SENSOR_ALERT_TEMP_C_HIGH=
# SENSOR_ALERT_HUMIDITY_LOW=
# SENSOR_ALERT_MQ135_RAW_HIGH=
# SENSOR_ALERT_MQ9_RAW_HIGH=
# SENSOR_ALERT_RSSI_DBM_LOW=

# Keep this off during normal collection. It allows labeled synthetic
# WebSocket traffic and never writes those values to the CSV log.
SENSOR_ALLOW_TEST_INJECT=0
